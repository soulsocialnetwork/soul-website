---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'soul.',
  description = 'Uma rede social projetada para devolver a sua atenção. Menos algoritmo, mais humano.',
} = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <!-- viewport: interactive-widgets=resizes-content prevents mobile browser bar jumps -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, interactive-widgets=resizes-content" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/video-intro-poster.jpg" />
    <!-- Mobile chrome color -->
    <meta name="theme-color" content="#0a0a0c" />
    <!-- PWA / standalone -->
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <!-- Favicon -->
    <link rel="icon" href="/soulzinho-logo.svg" type="image/svg+xml" />

    <!-- Preconnect fonts before stylesheet -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Inter via preload (display=swap avoids FOIT) -->
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
      rel="preload"
      as="style"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <!-- Preload critical assets -->
    <link rel="preload" href="/logo.svg" as="image" type="image/svg+xml" />
    <link rel="preload" href="/video-intro-poster.jpg" as="image" />
  </head>
  <body>
    <slot />
  </body>
</html>
